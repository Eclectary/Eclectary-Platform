# Local defaults. Use a separate PostgreSQL instance and nonstandard port for
# disposable integration testing; see the repository README.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=back_end_development
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# Integration testing additionally requires explicit per-terminal confirmation,
# a private proof secret, and a Unix socket. See the repository README; do not
# put shared or production credentials in these settings.

# Not required in development; provide it only for environments that require
# encrypted Rails credentials.
RAILS_MASTER_KEY=

# These application metadata values are optional and currently have no runtime
# consumers. The Rails API routes are namespaced directly in config/routes.rb.
API_BASE_URL=http://localhost:3000/api/v1
API_VERSION=v1

# Exact frontend origin only. Development already permits localhost:5173.
FRONTEND_URL=http://localhost:5173

# Optional placeholders; local checkout does not process payments.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional; local API startup does not require SMTP.
MAILER_FROM=
MAILER_HOST=
MAILER_PORT=
MAILER_USERNAME=
MAILER_PASSWORD=
