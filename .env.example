# Optional in local development; this is also the built-in development fallback.
# Production builds require an explicit HTTPS URL including the API namespace.
VITE_API_URL=http://localhost:3000/api/v1

# Browser integration mode uses a same-origin API URL and an existing Rails Unix
# socket. Supply these when starting Vite with --mode integration; do not use
# this socket setting for normal development or production.
# VITE_API_URL=/api/v1
# INTEGRATION_API_SOCKET=/absolute/path/to/BackEnd/tmp/integration-api.sock

# Optional destination for Feedback links; defaults to the local Rails origin.
VITE_FEEDBACK_URL=http://localhost:3000
